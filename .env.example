# =============================================================================
# Risk-Gated Agentic AML Monitoring PoC - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# NEVER commit the .env file to version control.
# =============================================================================

# --- PostgreSQL Configuration ---
POSTGRES_USER=aml_user
POSTGRES_PASSWORD=aml_password
POSTGRES_DB=aml_local

# --- n8n Configuration ---
# Generate with: openssl rand -hex 32
# CRITICAL: Set before first run, keep stable across restarts.
# Changing this will make saved n8n credentials unusable.
N8N_ENCRYPTION_KEY=replace_with_openssl_rand_hex_32_output

# --- AI API Configuration (Groq) ---
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Email Notification (Gmail SMTP) ---
# SMTP_HOST: Always smtp.gmail.com for Gmail
# SMTP_USER: Your full Gmail address (e.g. yourname@gmail.com)
# SMTP_PASS: The 16-char App Password from https://myaccount.google.com/apppasswords
#            (NOT your Gmail login password)
SMTP_HOST=smtp.gmail.com
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=compliance-demo@example.com
COMPLIANCE_ALERT_TO=compliance-demo@example.com
